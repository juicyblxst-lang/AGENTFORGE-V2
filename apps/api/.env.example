# BSC Testnet default; set bsc-mainnet for mainnet deployments
NETWORK=bsc-testnet
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Public API access; include the deployed frontend origin(s)
CORS_ORIGINS=http://localhost:5173

# Optional 8004scan API key; discovery works against the public indexer without one.
EIGHTYFOUR_SCAN_API_KEY=

# ERC-8183 provider wallet used to budget, execute and submit jobs assigned to PROVIDER_ADDRESS.
# Never commit a real private key.
PROVIDER_PRIVATE_KEY=
PROVIDER_ADDRESS=

# Public provider base URL INCLUDING /erc8183. The SDK uses it to expose local deliverables.
# Example: https://agentforge-v2-api.onrender.com/erc8183
PROVIDER_AGENT_BASE_URL=

# Render: use the managed Postgres DATABASE_URL. Local fallback is SQLite.
DATABASE_URL=
DATABASE_PATH=./agentforge.db

# Price is whole settlement-token units; the SDK reads token decimals from the Commerce contract.
SERVICE_PRICE_UNITS=1
POLL_INTERVAL_SECONDS=15
