# BSC Testnet only
NETWORK=bsc-testnet
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Public API access
CORS_ORIGINS=http://localhost:5173

# Optional 8004scan API key; discovery works against the public indexer without one.
EIGHTYFOUR_SCAN_API_KEY=

# Provider wallet: MUST own the ERC-8004 agent being hired.
# Never commit a real private key.
PROVIDER_PRIVATE_KEY=
PROVIDER_ADDRESS=

# Public URL of this Render service (used by bnbagent LocalStorageProvider to publish deliverables).
# Example: https://agentforge-api.onrender.com
PROVIDER_AGENT_BASE_URL=

# Render: use the managed Postgres DATABASE_URL. Local fallback is SQLite.
DATABASE_URL=
DATABASE_PATH=./agentforge.db

# Price is whole settlement-token units; BSC testnet APEX uses U token.
SERVICE_PRICE_UNITS=1
POLL_INTERVAL_SECONDS=15
